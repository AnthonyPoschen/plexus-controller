FROM golang:1.26.3-alpine AS supervisor
WORKDIR /src
COPY go.mod go.sum ./
COPY vendor ./vendor
COPY . .
RUN CGO_ENABLED=0 go build -mod=vendor -trimpath -ldflags="-s -w" -o /game-supervisor ./cmd/game-supervisor

# Game files come from the matching dedicated-server patch. The published
# runtime replaces that image's entrypoint with the Plexus supervisor.
ARG FACTORIO_VERSION=2.0.77
FROM factoriotools/factorio:${FACTORIO_VERSION}
USER root
COPY --from=supervisor /game-supervisor /usr/local/bin/game-supervisor
RUN chmod 0755 /usr/local/bin/game-supervisor
USER factorio
ENTRYPOINT ["/usr/local/bin/game-supervisor"]
